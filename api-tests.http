  "quantity": 1,
  "includedDurationMinutes": 120,
  "includedChemicalQuantity": null,
  "notes": "Included in package test"
}

### Delete item from provider service package
DELETE {{baseUrl}}/provider/service-packages/{{packageId}}/items/{{packageItemId}}
Authorization: Bearer {{providerLogin.response.body.$.token}}

