# Backend API base URL used directly by the browser.
# Leave EMPTY during local dev: requests then go to /api on this Next.js app
# and are proxied to the backend (no CORS / self-signed cert issues).
NEXT_PUBLIC_API_URL=

# Where the dev proxy forwards /api/* requests (backend HTTP port).
# Capstone backend (GFA26SE169_FA26SE091_API): http://localhost:5038
API_PROXY_TARGET=http://localhost:5038