# Direct download URL for the latest Android APK from GitHub Releases
NEXT_PUBLIC_APK_DOWNLOAD_URL=https://github.com/LeQuangVinh11022004/film-photo-platform-mobile/releases/latest/download/app-release.apk

# Backend API base URL used directly by the browser.
# Leave EMPTY during local dev: requests then go to /api on this Next.js app
# and are proxied to the backend (no CORS / self-signed cert issues).
NEXT_PUBLIC_API_URL=https://filmbooking-api-h7bghwcydwb8eecn.japaneast-01.azurewebsites.net/api

# Where the dev proxy forwards /api/* requests (backend HTTPS port to preserve Authorization header).
# Capstone backend (GFA26SE169_FA26SE091_API): https://localhost:7104
API_PROXY_TARGET=https://filmbooking-api-h7bghwcydwb8eecn.japaneast-01.azurewebsites.net
# Restart the dev server after changing these values.